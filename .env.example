# Equity scanner
STOCKPY_WORKERS=3
STOCKPY_PERIOD=1y

# Telegram (used by equity scans and F&O pre-market reports)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PREMARKET_NOTIFY=true

# Schedule (IST)
PREMARKET_TIMEZONE=Asia/Kolkata
PREMARKET_REPORT_TIME=09:00
MARKET_OPEN_TIME=09:15
CONFIRMATION_TIME=09:30

# Symbols (Yahoo / NSE)
NIFTY_SYMBOL=^NSEI
BANKNIFTY_SYMBOL=^NSEBANK
INDIA_VIX_SYMBOL=^INDIAVIX
GIFT_NIFTY_SYMBOL=
NSE_OPTION_NIFTY=NIFTY
NSE_OPTION_BANKNIFTY=BANKNIFTY

# Persistence
PREMARKET_DB_PATH=data/premarket.db

# API resilience
PREMARKET_API_TIMEOUT=15
PREMARKET_API_RETRIES=3
PREMARKET_API_RETRY_BACKOFF=1.5

# Gap classification (% of previous close)
GAP_FLAT_PCT=0.10
GAP_SMALL_PCT=0.30
GAP_MODERATE_PCT=0.70

# VIX / PCR thresholds
VIX_ELEVATED=18
VIX_HIGH=22
PCR_BULLISH=1.0
PCR_BEARISH=0.7

# Strike intervals
NIFTY_STRIKE_INTERVAL=50
BANKNIFTY_STRIKE_INTERVAL=100
IMPORTANT_STRIKES_RADIUS=5

# Scoring weights
WEIGHT_GAP=2.0
WEIGHT_NIFTY_TREND=2.0
WEIGHT_BANKNIFTY_TREND=1.5
WEIGHT_GLOBAL=1.5
WEIGHT_GIFT=1.5
WEIGHT_VIX=1.0
WEIGHT_FII_DII=1.5
WEIGHT_OPTION_OI=1.5
WEIGHT_PCR=1.0
WEIGHT_OI_CHANGE=1.0
WEIGHT_SR=1.0
WEIGHT_EVENTS=0.5
